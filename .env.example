# API Gateway Base URL — the single public entry point for all backend services.
VITE_API_URL=https://ubiquitous-trout-9xv7wpgv7q92x99g-8080.app.github.dev

# Authorization requests use the same gateway.
VITE_AUTHORIZATION_API_URL=https://ubiquitous-trout-9xv7wpgv7q92x99g-8080.app.github.dev

# Public Cloudflare Turnstile site key. Vite embeds it at BUILD time.
# Use a Cloudflare test widget for local automation, never production keys.
VITE_TURNSTILE_SITEKEY=
